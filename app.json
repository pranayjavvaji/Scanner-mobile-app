{
  "expo": {
    "name": "BarScan",
    "slug": "barscan",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1115"
      },
      "package": "com.barscan.app",
      "permissions": [
        "CAMERA",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "BarScan uses the camera to read barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BarScan reads barcodes from photos you choose."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sqlite"
    ]
  }
}
